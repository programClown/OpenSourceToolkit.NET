<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:controls="using:OpenSourceToolkit.NET.Controls"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenSourceToolkit.NET.Views.Tools.EthConverterToolView"
             x:DataType="vm:EthConverterToolViewModel">
    <StackPanel Spacing="10">
        <StackPanel Spacing="10">
            <TextBlock Text="{loc:Localize EthConverter_Amount_Label}" />
            <controls:NumericEntry Value="{Binding Eth}" />
        </StackPanel>
        <daisy:DaisyButton Command="{Binding ConvertCommand}" Content="{loc:Localize Button_Convert}" Variant="Primary" HorizontalAlignment="Left" />
        <controls:CopyableTextBox Text="{Binding Output}" IsReadOnly="True" Height="100" AcceptsReturn="True" />
    </StackPanel>
</UserControl>
