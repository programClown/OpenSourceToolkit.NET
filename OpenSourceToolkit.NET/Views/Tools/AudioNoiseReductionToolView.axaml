<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:converters="clr-namespace:OpenSourceToolkit.NET.Converters"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="OpenSourceToolkit.NET.Views.Tools.AudioNoiseReductionToolView"
             x:DataType="vm:AudioNoiseReductionToolViewModel">

  <ScrollViewer>
    <StackPanel Spacing="10">
      <!-- Platform Not Supported Warning -->
      <Border Background="{DynamicResource DaisyErrorBrush}" Opacity="0.2" CornerRadius="5" Padding="15" IsVisible="{Binding !IsAudioSupported}">
        <StackPanel Spacing="5">
          <TextBlock Text="{loc:Localize Audio_PlatformNotSupported_Title}" FontWeight="Bold" Foreground="{DynamicResource DaisyErrorBrush}"/>
          <TextBlock Text="{loc:Localize Audio_PlatformNotSupported_Desc}" Foreground="{DynamicResource DaisyErrorBrush}" TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>
      </Border>

      <!-- Audio Device Selection -->
      <Border Background="{DynamicResource DaisyBase200Brush}" CornerRadius="5" Padding="10"
              IsVisible="{Binding IsAudioSupported}">
        <Grid ColumnDefinitions="Auto, 10, *, 20, Auto">
          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_InputDevice_Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <ComboBox Grid.Column="2" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                    HorizontalAlignment="Left" MaxWidth="400" IsEnabled="{Binding !IsRecording}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <daisy:DaisyButton Grid.Column="4" Command="{Binding RefreshDevicesCommand}" Content="⟳" ToolTip.Tip="{loc:Localize Audio_RefreshDevices_Tooltip}"
                  Size="Small" IsEnabled="{Binding !IsRecording}"/>
        </Grid>
      </Border>

      <!-- Peak Meter -->
      <Border Background="{DynamicResource DaisyBase200Brush}" CornerRadius="5" Padding="10"
              IsVisible="{Binding IsAudioSupported}">
        <StackPanel Spacing="5">
          <DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Left">
              <ToggleButton Command="{Binding ToggleMonitoringCommand}" IsChecked="{Binding IsMonitoring, Mode=OneWay}"
                            IsEnabled="{Binding !IsRecording}" ToolTip.Tip="{loc:Localize Audio_MonitorMic_Tooltip}" Padding="6,4">
                <Path Data="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M19,11C19,14.53 16.39,17.43 13,17.92V21H11V17.92C7.61,17.43 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                      Fill="{Binding $parent[ToggleButton].Foreground}" Width="14" Height="14" Stretch="Uniform"/>
              </ToggleButton>
              <TextBlock Text="{loc:Localize Audio_InputLevel_Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding PeakLevel, StringFormat='{}{0:P0}'}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}"/>
          </DockPanel>
          <Grid Height="24" x:Name="PeakMeterGrid">
            <Border Background="#333" CornerRadius="3"/>
            <Border CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Left">
              <Border.Width>
                <MultiBinding>
                  <MultiBinding.Converter>
                    <converters:PeakMeterWidthConverter/>
                  </MultiBinding.Converter>
                  <Binding Path="PeakLevel"/>
                  <Binding Path="Bounds.Width" ElementName="PeakMeterGrid"/>
                </MultiBinding>
              </Border.Width>
              <Border CornerRadius="3" HorizontalAlignment="Left">
                <Border.Width>
                  <Binding Path="Bounds.Width" ElementName="PeakMeterGrid"/>
                </Border.Width>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#22C55E" Offset="0"/>
                    <GradientStop Color="#22C55E" Offset="0.6"/>
                    <GradientStop Color="#EAB308" Offset="0.8"/>
                    <GradientStop Color="#EF4444" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Border>
            <!-- Peak markers at 70% and 85% -->
            <Grid ColumnDefinitions="70*, 1, 14*, 1, 15*">
              <Rectangle Grid.Column="1" Fill="#666" Opacity="0.5"/>
              <Rectangle Grid.Column="3" Fill="#666" Opacity="0.5"/>
            </Grid>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="8" Height="8" Fill="#22C55E"/>
              <TextBlock Text="{loc:Localize Audio_Level_Normal}" FontSize="11" Foreground="{DynamicResource DaisyBaseContentBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="8" Height="8" Fill="#EAB308"/>
              <TextBlock Text="{loc:Localize Audio_Level_Loud}" FontSize="11" Foreground="{DynamicResource DaisyBaseContentBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="8" Height="8" Fill="#EF4444"/>
              <TextBlock Text="{loc:Localize Audio_Level_Clipping}" FontSize="11" Foreground="{DynamicResource DaisyBaseContentBrush}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Status Bar -->
      <Border Background="{DynamicResource DaisyBase200Brush}" CornerRadius="5" Padding="10"
              IsVisible="{Binding IsAudioSupported}">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Left">
             <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" DockPanel.Dock="Right" IsVisible="{Binding IsRecording}">
             <TextBlock Text="{loc:Localize Audio_RecordingTime_Label}" VerticalAlignment="Center"/>
             <TextBlock Text="{Binding RecordingTimeDisplay}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DaisyErrorBrush}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid ColumnDefinitions="*, 20, *" RowDefinitions="Auto" IsVisible="{Binding IsAudioSupported}">

        <!-- Input Section -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1" CornerRadius="5" Padding="10">
          <StackPanel Spacing="15">
             <TextBlock Text="{loc:Localize Audio_AudioInput_Header}" FontSize="18" FontWeight="SemiBold"/>
             <TextBlock Text="{loc:Localize Audio_RecordOrUpload_Desc}" FontSize="12" Foreground="{DynamicResource DaisyBaseContentBrush}"/>

             <Grid ColumnDefinitions="*, 10, *">
                <daisy:DaisyButton Grid.Column="0" Command="{Binding ToggleRecordingCommand}" Variant="Primary">
                   <Panel>
                       <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsRecording}" HorizontalAlignment="Center">
                            <Path Data="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M19,11C19,14.53 16.39,17.43 13,17.92V21H11V17.92C7.61,17.43 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                  Fill="{Binding $parent[daisy:DaisyButton].Foreground}" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="{loc:Localize Audio_StartRecording_Button}" VerticalAlignment="Center"/>
                       </StackPanel>
                       <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsRecording}" HorizontalAlignment="Center">
                            <Path Data="M18,18H6V6H18V18Z" Fill="Red" Width="16" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="{Binding RecordingTimeDisplay, StringFormat='Stop ({0})'}" VerticalAlignment="Center" FontWeight="Bold"/>
                       </StackPanel>
                   </Panel>
                </daisy:DaisyButton>
                <daisy:DaisyButton Grid.Column="2" Command="{Binding UploadFileAsyncCommand}" Content="{loc:Localize Audio_ImportFile_Button}" Variant="Primary"/>
             </Grid>

             <!-- File Info -->
             <Border IsVisible="{Binding HasAudioFile}" Background="{DynamicResource DaisyBase200Brush}" Margin="0,10,0,0" Padding="10">
                 <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Localize Audio_AudioLoaded_Status}"/>
                 </StackPanel>
             </Border>
          </StackPanel>
        </Border>

        <!-- Settings Section -->
        <Border Grid.Column="2" BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1" CornerRadius="5" Padding="10">
           <StackPanel Spacing="10">
              <DockPanel>
                 <TextBlock Text="{loc:Localize Audio_ProcessingSettings_Header}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                 <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                    <daisy:DaisyButton Command="{Binding ProcessAudioCommand}" Content="{loc:Localize Common_Apply_Button}" Variant="Primary" IsEnabled="{Binding HasAudioFile}"/>
                    <daisy:DaisyButton Command="{Binding ResetCommand}" Content="{loc:Localize Common_Reset_Button}"/>
                 </StackPanel>
              </DockPanel>

              <daisy:DaisyTabs MinHeight="180" Variant="Boxed" Size="Small">
                 <TabItem Header="{loc:Localize Audio_Basic_Tab}">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Gain_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding Gain}" Minimum="-20" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                          <TextBlock Grid.Column="2" Text="{Binding Gain, StringFormat='{}{0:F1} dB'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_HighPass_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding HighPassFilter}" Minimum="20" Maximum="500"/>
                          <TextBlock Grid.Column="2" Text="{Binding HighPassFilter, StringFormat='{}{0:F0} Hz'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_LowPass_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding LowPassFilter}" Minimum="1000" Maximum="20000"/>
                          <TextBlock Grid.Column="2" Text="{Binding LowPassFilter, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                    </StackPanel>
                 </TabItem>

                 <TabItem Header="{loc:Localize Audio_Compressor_Tab}">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Threshold_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding CompThreshold}" Minimum="-40" Maximum="0"/>
                          <TextBlock Grid.Column="2" Text="{Binding CompThreshold, StringFormat='{}{0:F0} dB'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Ratio_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding CompRatio}" Minimum="1" Maximum="20"/>
                          <TextBlock Grid.Column="2" Text="{Binding CompRatio, StringFormat='{}{0:F1}:1'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Attack_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding CompAttack}" Minimum="0" Maximum="100"/>
                          <TextBlock Grid.Column="2" Text="{Binding CompAttack, StringFormat='{}{0:F0} ms'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Release_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding CompRelease}" Minimum="10" Maximum="1000"/>
                          <TextBlock Grid.Column="2" Text="{Binding CompRelease, StringFormat='{}{0:F0} ms'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                    </StackPanel>
                 </TabItem>

                 <TabItem Header="{loc:Localize Audio_EQ_Tab}">
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Bass_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding EqBass}" Minimum="-12" Maximum="12"/>
                          <TextBlock Grid.Column="2" Text="{Binding EqBass, StringFormat='{}{0:F1} dB'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Mid_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding EqMid}" Minimum="-12" Maximum="12"/>
                          <TextBlock Grid.Column="2" Text="{Binding EqMid, StringFormat='{}{0:F1} dB'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                       <Grid ColumnDefinitions="90, *, 50">
                          <TextBlock Grid.Column="0" Text="{loc:Localize Audio_Treble_Label}" VerticalAlignment="Center"/>
                          <Slider Grid.Column="1" Value="{Binding EqTreble}" Minimum="-12" Maximum="12"/>
                          <TextBlock Grid.Column="2" Text="{Binding EqTreble, StringFormat='{}{0:F1} dB'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource DaisyBaseContentBrush}" FontSize="11"/>
                       </Grid>
                    </StackPanel>
                 </TabItem>
              </daisy:DaisyTabs>
           </StackPanel>
        </Border>
      </Grid>

      <!-- Playback Section -->
      <Border BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1" CornerRadius="5" Padding="15" IsVisible="{Binding HasAudioFile}"
              IsEnabled="{Binding IsAudioSupported}">
         <StackPanel Spacing="15">
            <TextBlock Text="{loc:Localize Audio_PlaybackExport_Header}" FontSize="18" FontWeight="SemiBold"/>

            <Grid ColumnDefinitions="*, 20, *">
               <StackPanel Grid.Column="0" Spacing="10">
                  <TextBlock Text="{loc:Localize Audio_Playback_Label}" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                     <daisy:DaisyButton Command="{Binding PlayOriginalCommand}" IsEnabled="{Binding !IsRecording}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                           <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{Binding $parent[daisy:DaisyButton].Foreground}" Width="12" Height="12" Stretch="Uniform"/>
                           <TextBlock Text="{loc:Localize Audio_Original_Button}" VerticalAlignment="Center"/>
                        </StackPanel>
                     </daisy:DaisyButton>
                     <daisy:DaisyButton Command="{Binding PlayProcessedCommand}" IsEnabled="{Binding !IsRecording}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                           <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="{Binding $parent[daisy:DaisyButton].Foreground}" Width="12" Height="12" Stretch="Uniform"/>
                           <TextBlock Text="{loc:Localize Audio_Processed_Button}" VerticalAlignment="Center"/>
                        </StackPanel>
                     </daisy:DaisyButton>
                     <daisy:DaisyButton Command="{Binding StopPlaybackCommand}" IsVisible="{Binding IsPlaying}" Variant="Error">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                           <Path Data="M6,6H18V18H6V6Z" Fill="#F87171" Width="12" Height="12" Stretch="Uniform"/>
                           <TextBlock Text="{loc:Localize Audio_Stop_Button}" VerticalAlignment="Center"/>
                        </StackPanel>
                     </daisy:DaisyButton>
                  </StackPanel>
               </StackPanel>

               <StackPanel Grid.Column="2" Spacing="10">
                  <TextBlock Text="{loc:Localize Audio_Export_Label}" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*, 10, Auto">
                     <ComboBox Grid.Column="0" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}"
                               HorizontalAlignment="Stretch"/>
                     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsMp3Selected}">
                        <ComboBox ItemsSource="{Binding Mp3Bitrates}" SelectedItem="{Binding SelectedMp3Bitrate}" Width="70"/>
                        <TextBlock Text="{loc:Localize Audio_Kbps_Unit}" VerticalAlignment="Center" Foreground="{DynamicResource DaisyBaseContentBrush}"/>
                     </StackPanel>
                  </Grid>
                  <daisy:DaisyButton Command="{Binding ExportAsyncCommand}" MaxWidth="200" HorizontalAlignment="Left" IsEnabled="{Binding !IsRecording}" Variant="Primary">
                     <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{loc:Localize Audio_Export_Label}"/>
                        <TextBlock Text="{Binding SelectedExportFormat}"/>
                     </StackPanel>
                  </daisy:DaisyButton>
               </StackPanel>
            </Grid>
         </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
