<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenSourceToolkit.NET.ViewModels.Tools"
             xmlns:controls="using:OpenSourceToolkit.NET.Controls"
             xmlns:daisy="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:OpenSourceToolkit.NET.Localization"
             x:Class="OpenSourceToolkit.NET.Views.Tools.LoremIpsumToolView"
             x:DataType="vm:LoremIpsumToolViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{loc:Localize Label_Count}" VerticalAlignment="Center"/>
            <daisy:DaisyNumericUpDown Value="{Binding Count}" Minimum="1" Maximum="500" Increment="1" FormatString="0" MinWidth="120" Size="Small" />
            <daisy:DaisyButton Command="{Binding GenerateWordsCommand}" Content="{loc:Localize LoremIpsum_GenerateWords_Button}" Variant="Primary" HorizontalAlignment="Left" />
            <daisy:DaisyButton Command="{Binding GenerateSentencesCommand}" Content="{loc:Localize LoremIpsum_GenerateSentences_Button}" Variant="Secondary" />
            <daisy:DaisyButton Command="{Binding GenerateParagraphsCommand}" Content="{loc:Localize LoremIpsum_GenerateParagraphs_Button}" Variant="Secondary" />
        </StackPanel>
        <controls:CopyableTextBox Grid.Row="1"
                                  Text="{Binding Output}"
                                  IsReadOnly="True"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  Margin="0,10,0,0"/>
    </Grid>
</UserControl>
