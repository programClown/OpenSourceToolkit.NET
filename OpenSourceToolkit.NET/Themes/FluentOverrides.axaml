<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 
    FluentTheme Overrides
    =====================
    These override FluentTheme's resource keys to use DaisyUI colors.
    Important for standard Avalonia controls (TextBox, DataGrid, TabControl, etc.)
    that don't use DaisyUI controls directly.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Foreground overrides for text controls -->
            <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource DaisyBaseContentColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource DaisyBaseContentColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{DynamicResource DaisyNeutralContentColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{DynamicResource DaisyNeutralContentColor}" />

            <!-- Background overrides for standard controls -->
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{DynamicResource DaisyBase100Color}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{DynamicResource DaisyBase200Color}" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{DynamicResource DaisyBase300Color}" />
            
            <!-- DataGrid specific overrides -->
            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{DynamicResource DaisyBase200Color}" />
            <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="{DynamicResource DaisyBase200Color}" />
            
            <!-- TabItem header foreground override -->
            <SolidColorBrush x:Key="TabItemHeaderForeground" Color="{DynamicResource DaisyBaseContentColor}" />
            <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource DaisyNeutralContentColor}" />

            <!-- Slider thumb size overrides (make slider smaller) -->
            <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <x:Double x:Key="SliderVerticalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderVerticalThumbHeight">16</x:Double>
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Override TabItem header foreground (FluentTheme defaults don't use our brushes) -->
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
</Styles>
